---
import { SITE_TAGLINE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="brand">
			<h2>
				<a href="/">{SITE_TITLE}</a>
			</h2>
			<p class="site-tagline">{SITE_TAGLINE}</p>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/archives">Archives</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<script>
	// The header stays on screen, so anchor links must stop below it (its height changes with the layout).
	const header = document.querySelector('header');
	if (header) {
		const update = () => {
			document.documentElement.style.scrollPaddingTop = `${header.offsetHeight + 16}px`;
		};
		new ResizeObserver(update).observe(header);
		update();
	}
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		padding: 1em 0.5em;
	}
	nav h2 a {
		padding: 0;
		border-bottom: 0;
		font-size: 1.44em;
	}
	.site-tagline {
		margin: 0;
		font-family: var(--font-domitian);
		font-style: italic;
		font-weight: 400;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	nav {
		box-sizing: border-box;
		max-width: 1036px;
		margin: 0 auto;
		padding-inline: 8px;
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		justify-content: space-between;
	}
	.internal-links {
		display: flex;
		font-family: var(--font-jost);
		font-weight: 500;
	}
	@media (max-width: 720px) {
		header {
			padding-inline: 0.5em;
		}
		nav {
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}
		.brand {
			padding-bottom: 0;
			text-align: center;
		}
		.internal-links {
			margin-top: -0.5em;
		}
	}
	.internal-links a {
		display: flex;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
	}
	.internal-links a:hover,
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (min-width: 721px) {
		.brand {
			padding-block: calc(0.425em + 0.05em) calc(0.425em - 0.05em);
		}
		.internal-links a {
			padding-block: calc(1em + 2.5px) calc(1em - 2.5px);
		}
	}
</style>
