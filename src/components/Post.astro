---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	title: string;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
	/** When set, the title links here and renders as an h2 instead of the page's h1. Text after a `<!--more-->` marker is hidden behind a "Read more" link. */
	href?: string;
}

const { title, pubDate, updatedDate, tags = [], href } = Astro.props;
const Heading = href ? 'h2' : 'h1';
---

<article data-pagefind-body={pubDate && !href ? '' : undefined}>
	<div class="prose">
		<div class="title">
			<Heading class="heading">
				{href ? <a href={href}>{title}</a> : title}
			</Heading>
			{
				(pubDate || tags.length > 0) && (
					<p class="meta">
						{pubDate && <FormattedDate date={pubDate} />}
						{pubDate && tags.length > 0 && ' · '}
						<TagList tags={tags} />
					</p>
				)
			}
			{
				pubDate && updatedDate && (
					<p class="last-updated-on">
						Last updated on <FormattedDate date={updatedDate} />
					</p>
				)
			}
			<hr />
		</div>
		<div class="body" data-excerpt={href ? '' : undefined}>
			<slot />
		</div>
		{
			href && (
				<a class="read-more" href={href}>
					Read more →
				</a>
			)
		}
	</div>
</article>
<script>
	// E-mail addresses are only assembled in the browser, so scrapers reading the page source don't find them.
	document.querySelectorAll<HTMLElement>('.email[data-user][data-domain]').forEach((el) => {
		const address = `${el.dataset.user}@${el.dataset.domain}`;
		const link = document.createElement('a');
		link.href = `mailto:${address}`;
		link.textContent = address;
		el.replaceWith(link);
	});
</script>
<script>
	// Videos are a thumbnail with a link to YouTube; the player is only loaded once someone clicks it.
	document.addEventListener('click', (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>('a.yt-embed');
		if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
		event.preventDefault();
		const player = document.createElement('iframe');
		player.src = `https://www.youtube-nocookie.com/embed/${link.dataset.youtube}?autoplay=1`;
		player.title = link.title;
		player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
		player.allowFullscreen = true;
		link.replaceWith(player);
	});
</script>
<style>
	article + article {
		margin-top: 1em;
	}
	.prose {
		width: 1000px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: var(--gray-dark);
		font-size: 0.9em;
		line-height: 1.5;
	}
	.body :global(.video) {
		margin: 1.5em 0;
	}
	.body :global(.yt-embed) {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		background: #000;
	}
	.body :global(.yt-embed img) {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
	}
	.body :global(.yt-play) {
		position: absolute;
		inset: 0;
		width: 68px;
		height: 48px;
		margin: auto;
		border-radius: 12px;
		background: #000000b3;
		transition: background 0.2s ease;
	}
	.body :global(.yt-play)::after {
		content: '';
		position: absolute;
		top: 14px;
		left: 28px;
		border-style: solid;
		border-width: 10px 0 10px 18px;
		border-color: transparent transparent transparent #fff;
	}
	.body :global(.yt-embed:hover .yt-play) {
		background: var(--accent);
	}
	.body :global(.video iframe) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}
	.body :global(audio),
	.body :global(video) {
		display: block;
		width: 100%;
		margin: 1em 0;
	}
	.body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1em;
	}
	.body :global(th),
	.body :global(td) {
		padding: 0.3em 0.6em;
		border-bottom: 1px solid var(--gray-light);
		text-align: left;
	}
	/* A single image that is narrower than the text column is centered. */
	.body :global(p > img:only-child),
	.body :global(p > a:only-child > img:only-child) {
		display: block;
		margin-inline: auto;
	}
	/* Images written next to each other in one paragraph form a row. */
	.body :global(p:has(> :is(img, a:has(> img)) + :is(img, a:has(> img)))) {
		display: flex;
		align-items: flex-start;
		gap: 1em;
	}
	.body :global(p:has(> :is(img, a:has(> img)) + :is(img, a:has(> img))) > br) {
		display: none;
	}
	.body :global(p:has(> :is(img, a:has(> img)) + :is(img, a:has(> img))) > :is(img, a)) {
		flex: 1 1 0;
		min-width: 0;
	}
	.body :global(p:has(> :is(img, a:has(> img)) + :is(img, a:has(> img))) > a > img) {
		width: 100%;
	}
	@media (max-width: 720px) {
		.body :global(p:has(> :is(img, a:has(> img)) + :is(img, a:has(> img)))) {
			flex-direction: column;
		}
	}
	.body :global(.more-marker) {
		display: none;
	}
	[data-excerpt] :global(.more-marker ~ *) {
		display: none;
	}
	.body > :global(:last-child) {
		margin-bottom: 0;
	}
	[data-excerpt] > :global(:has(+ .more-marker)) {
		margin-bottom: 0;
	}
	.read-more {
		display: none;
		margin-top: 0.5em;
		font-family: var(--font-jost);
		font-weight: 500;
		text-decoration: none;
	}
	.body:has(:global(.more-marker)) + .read-more {
		display: inline-block;
	}
	.read-more:hover {
		color: var(--accent-dark);
	}
	.title {
		margin-bottom: 1em;
		padding: 0;
		text-align: left;
		line-height: 1.2;
	}
	.title .heading {
		margin: 0 0 0.15em 0;
		font-size: 1.6em;
	}
	.heading a {
		color: inherit;
		text-decoration: none;
	}
	.heading a:hover {
		color: var(--accent);
	}
	.title hr {
		margin: 0.5em 0 0;
		border-top: 2px solid var(--accent);
	}
	.meta {
		margin: 0;
		font-style: italic;
		color: var(--gray);
	}
	.last-updated-on {
		margin: 0;
		font-style: italic;
		color: var(--gray);
	}
</style>
