---
import type { CollectionEntry } from 'astro:content';
import Post from '../components/Post.astro';
import PostNav from '../components/PostNav.astro';
import { SITE_DESCRIPTION } from '../consts';
import Page from './Page.astro';

type Props = Omit<CollectionEntry<'blog'>['data'], 'tags' | 'pubDate'> & {
	tags?: string[];
	pubDate?: Date;
	prev?: { title: string; href: string };
	next?: { title: string; href: string };
};

const { title, description, pubDate, updatedDate, tags, prev, next } = Astro.props;
---

<Page title={title} description={description ?? SITE_DESCRIPTION}>
	<Post title={title} pubDate={pubDate} updatedDate={updatedDate} tags={tags}>
		<slot />
	</Post>
	<PostNav prev={prev} next={next} />
</Page>
