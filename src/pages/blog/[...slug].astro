---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { plainExcerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
	);
	const link = (post?: CollectionEntry<'blog'>) =>
		post && { title: post.data.title, href: `/blog/${post.id}/` };
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { ...post, prev: link(posts[i - 1]), next: link(posts[i + 1]) },
	}));
}
type Props = CollectionEntry<'blog'> & {
	prev?: { title: string; href: string };
	next?: { title: string; href: string };
};

const { prev, next, ...post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
	{...post.data}
	description={post.data.description ?? plainExcerpt(post.body ?? '')}
	prev={prev}
	next={next}
>
	<Content />
</BlogPost>
