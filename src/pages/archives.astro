---
import { getCollection } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';
import { tagSlug, tagUrl } from '../lib/tags';

const posts = await getCollection('blog');
const counts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		const entry = counts.get(tagSlug(tag)) ?? { name: tag, count: 0 };
		entry.count++;
		counts.set(tagSlug(tag), entry);
	}
}
const tags = [...counts.values()].sort((a, b) =>
	a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }),
);

const byYear = new Map<number, typeof posts>();
for (const post of [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())) {
	const year = post.data.pubDate.getFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear];
const day = (date: Date) => date.toLocaleDateString('en-us', { month: 'short', day: 'numeric' });
---

<Layout title="Archives" description="Search and all posts, by tag and by year.">
	<h2>Search</h2>
	<div id="search"><p class="count">Search is available on the published site.</p></div>

	<h2>Archives by Tags</h2>
	<ul class="tags">
		{
			tags.map(({ name, count }) => (
				<li>
					<a href={tagUrl(name)}>{name}</a> <span class="count">({count})</span>
				</li>
			))
		}
	</ul>

	<h2>Archives by Year</h2>
	<ul class="tags years">
		{
			years.map(([year, yearPosts], i) => (
				<li>
					<a href={`#${year}`} data-year={year} aria-current={i === 0 ? 'true' : undefined}>
						{year}
					</a>{' '}
					<span class="count">({yearPosts.length})</span>
				</li>
			))
		}
	</ul>
	{
		years.map(([year, yearPosts]) => (
			<section class="year" id={String(year)} aria-label={String(year)}>
				<ul class="posts">
					{yearPosts.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString()}>{day(post.data.pubDate)}</time>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
	// Pagefind's index is generated by `npm run build`, so the search box only appears where it exists.
	const script = document.createElement('script');
	script.src = '/pagefind/pagefind-ui.js';
	script.onload = () => {
		document.querySelector('#search').replaceChildren();
		new PagefindUI({
			element: '#search',
			showImages: false,
			showSubResults: false,
			resetStyles: false,
			pageSize: 10,
		});
		document.querySelector('.pagefind-ui__search-input')?.focus();
	};
	document.head.append(script);
</script>
<script is:inline>
	// One year's posts are shown at a time; without JavaScript they are all listed.
	const links = [...document.querySelectorAll('.years a[data-year]')];
	const panels = [...document.querySelectorAll('section.year')];
	function showYear(year) {
		for (const panel of panels) panel.hidden = panel.id !== year;
		for (const link of links) {
			if (link.dataset.year === year) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	}
	for (const link of links) {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			showYear(link.dataset.year);
			history.replaceState(null, '', `#${link.dataset.year}`);
		});
	}
	const initial = location.hash.slice(1);
	showYear(panels.some((panel) => panel.id === initial) ? initial : links[0]?.dataset.year);
</script>
<style>
	:global(:root[data-theme='dark']) #search {
		--field-border: var(--gray);
	}
	#search {
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: var(--gray-dark);
		--pagefind-ui-background: var(--bg);
		--pagefind-ui-border: var(--gray-light);
		--pagefind-ui-font: var(--font-domitian), serif;
	}
	#search :global(.pagefind-ui),
	#search :global(.pagefind-ui *) {
		font-family: inherit;
	}
	#search :global(.pagefind-ui__search-input),
	#search :global(.pagefind-ui__result-excerpt),
	#search :global(.pagefind-ui__message) {
		font-size: 1em;
		font-weight: 400;
	}
	#search :global(.pagefind-ui__form::before) {
		top: calc(1.2em - 8px);
		left: 0.9em;
	}
	#search :global(.pagefind-ui__search-input) {
		height: 2.4em;
		padding-block: 0.2em 0;
		padding-inline: 2.4em 3em;
		font-size: 0.9em;
		border: 1.5px solid var(--field-border, #8a8a8a);
		border-radius: 12px;
		background-color: var(--bg);
		caret-color: var(--accent);
		box-shadow: none;
		transition: border-color 0.15s;
	}
	#search :global(.pagefind-ui__search-input:focus) {
		border-color: var(--accent);
		outline: none;
	}
	#search :global(.pagefind-ui__search-input::placeholder) {
		opacity: 0.5;
	}
	#search :global(.pagefind-ui__search-clear) {
		top: 0;
		right: 0.9em;
		height: 2.7em;
		display: flex;
		align-items: center;
		padding-block: 0.3em 0;
		font-size: 0.8em;
		border: none;
		background: transparent;
		color: var(--gray);
	}
	h2:not(:first-child) {
		margin-top: 2em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em 1.4em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.count {
		color: var(--gray);
	}
	.years {
		margin-bottom: 0.6em;
	}
	.years a[aria-current] {
		font-weight: 600;
	}
	.posts {
		margin: 0.3em 0 0;
		padding: 0;
		list-style: none;
	}
	.posts li {
		display: flex;
		gap: 1em;
	}
	.posts time {
		flex: 0 0 3.5em;
		color: var(--gray);
	}
</style>
